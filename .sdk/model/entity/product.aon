            json: "{\"operationId\":\"createProduct\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"example\":{\"name\":\"Wild-berries\",\"price\":4.99},\"schema\":{\"properties\":{\"name\":{\"description\":\"Name des Produkts\",\"example\":\"Wild-berries\",\"type\":\"string\"},\"price\":{\"description\":\"Preis des Produkts\",\"example\":4.99,\"format\":\"double\",\"minimum\":0,\"type\":\"number\"}},\"required\":[\"name\",\"price\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"example\":{\"id\":22,\"name\":\"Wild-berries\",\"price\":4.99,\"self_link\":\"/shop/v2/products/22\"},\"schema\":{\"properties\":{\"id\":{\"description\":\"Eindeutige ID des Produkts\",\"example\":22,\"type\":\"integer\"},\"name\":{\"description\":\"Name des Produkts\",\"example\":\"Wild-berries\",\"type\":\"string\"},\"price\":{\"description\":\"Preis des Produkts\",\"example\":4.99,\"format\":\"double\",\"minimum\":0,\"type\":\"number\"},\"self_link\":{\"description\":\"Selbstreferenz-Link zur Ressource\",\"example\":\"/shop/v2/products/22\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Created - Produkt wurde erfolgreich angelegt\",\"headers\":{\"Location\":{\"description\":\"URI der neu angelegten Ressource\",\"schema\":{\"example\":\"/shop/v2/products/22\",\"type\":\"string\"}}}},\"400\":{\"description\":\"Bad Request - Ungültige Eingabedaten\"},\"500\":{\"description\":\"Internal Server Error\"}},\"securitySource\":\"unspecified\"}"
